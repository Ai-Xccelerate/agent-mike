# Agent Mike frontend staging variables. Fill values in Railway; do not commit
# a populated copy.

# Foundation worker backend and this frontend's public origin.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WIDGET_ORIGIN=
NEXT_PUBLIC_MIKE_WIDGET_SITE_TOKEN=

# Clerk application shared with AIX Core.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ENCRYPTION_KEY=
CLERK_SIGN_IN_URL=https://app-staging.aiworkforce.md/login
CLERK_SIGN_UP_URL=https://app-staging.aiworkforce.md/signup
CLERK_ALLOWED_REDIRECT_ORIGINS=
CLERK_AUTHORIZED_PARTIES=https://app-staging.aiworkforce.md

# AIX Core access catalog.
NEXT_PUBLIC_CORE_API_URL=https://api-staging.aiworkforce.md
NEXT_PUBLIC_CORE_APP_URL=https://app-staging.aiworkforce.md

# Optional Foundation Grab reporter. Configure both or neither.
NEXT_PUBLIC_GRAB_URL=
NEXT_PUBLIC_GRAB_KEY=
