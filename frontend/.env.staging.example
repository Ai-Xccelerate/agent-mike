# Staging frontend variables for Railway → mike-frontend → Variables → Raw Editor.
# Paste this block, then fill every empty value.
# Do NOT commit a filled copy.
#
# Skip: MIKE_ALLOW_LOCAL_UNAUTH (must not be set on Railway).

# Public URL of mike-api (generate a domain on mike-api first, then paste it here)
NEXT_PUBLIC_API_URL=

# Public URL of this mike-frontend service
NEXT_PUBLIC_WIDGET_ORIGIN=

# Must match mike-api MIKE_WIDGET_SITE_TOKEN
NEXT_PUBLIC_MIKE_WIDGET_SITE_TOKEN=

# Copy from Jules or Nick FRONTEND staging, or aix-clerk-core-env-values.md
# Use the staging Clerk app (pk_live / sk_live for Core staging), not a new Clerk app.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Copy from Jules/Nick FE, or generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLERK_ENCRYPTION_KEY=

CLERK_SIGN_IN_URL=https://app-staging.aiworkforce.md/login
CLERK_SIGN_UP_URL=https://app-staging.aiworkforce.md/signup

# After this service has a public URL, put that origin here.
CLERK_ALLOWED_REDIRECT_ORIGINS=
CLERK_AUTHORIZED_PARTIES=https://app-staging.aiworkforce.md

NEXT_PUBLIC_CORE_API_URL=https://api-staging.aiworkforce.md
NEXT_PUBLIC_CORE_APP_URL=https://app-staging.aiworkforce.md
