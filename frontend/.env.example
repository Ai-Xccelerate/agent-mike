# AI Worker Foundation — frontend environment template. Copy to .env.local.

# Next.js rewrites /api/v1/* to this origin.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Public origin of this frontend (used by widget/embed configuration).
NEXT_PUBLIC_WIDGET_ORIGIN=http://localhost:3001

# Optional default public widget site token. Multi-tenant embeds pass ?site=.
NEXT_PUBLIC_MIKE_WIDGET_SITE_TOKEN=

# Clerk uses the same application as AIX Core. Authentication redirects to
# Core; this frontend intentionally has no local login or signup page.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ENCRYPTION_KEY=
CLERK_SIGN_IN_URL=https://app-staging.aiworkforce.md/login
CLERK_SIGN_UP_URL=https://app-staging.aiworkforce.md/signup
CLERK_ALLOWED_REDIRECT_ORIGINS=http://localhost:3001
CLERK_AUTHORIZED_PARTIES=https://app-staging.aiworkforce.md,http://localhost:3001

# AIX Core catalog/access API and application.
NEXT_PUBLIC_CORE_API_URL=https://api-staging.aiworkforce.md
NEXT_PUBLIC_CORE_APP_URL=https://app-staging.aiworkforce.md

# -- Grab (in-app bug and feedback reporting) ----------------------------------
# One launcher across the manager console. Both values or neither: without them
# no reporter loads at all, which is what a deployment that does not use Grab
# should get.
#
# The key is public by design — it identifies the Grab project, not a person —
# so NEXT_PUBLIC_ is correct here.
# Staging:    https://grab-api-staging.aiworkforce.md
# Production: https://grab-api.aiworkforce.md
NEXT_PUBLIC_GRAB_URL=
NEXT_PUBLIC_GRAB_KEY=
