# AI Worker Foundation — frontend environment template. Copy to .env.local.

# Next.js rewrites /api/v1/* to this origin.
NEXT_PUBLIC_API_URL=http://localhost:3000

# -- Grab (in-app bug and feedback reporting) ----------------------------------
# One launcher across the manager console. Both values or neither: without them
# no reporter loads at all, which is what a deployment that does not use Grab
# should get.
#
# The key is public by design — it identifies the Grab project, not a person —
# so NEXT_PUBLIC_ is correct here.
# Staging:    https://grab-api-staging.aiworkforce.md
# Production: https://grab-api.aiworkforce.md
NEXT_PUBLIC_GRAB_URL=
NEXT_PUBLIC_GRAB_KEY=
