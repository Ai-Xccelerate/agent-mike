# Agent Mike frontend — copy to .env.local. Do not commit secrets.

# Next.js rewrites /api/v1/* to this origin.
# Local:        http://localhost:3000
# Staging:      https://api-mike-staging.aiworkforce.md (or the Railway API URL)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Widget origin (embed / CORS-related public origin)
NEXT_PUBLIC_WIDGET_ORIGIN=http://localhost:3001

# Public site token for /widget chat. Must match API MIKE_WIDGET_SITE_TOKEN.
# Optional / unused for multi-tenant embeds (token comes from ?site= in the iframe URL).
NEXT_PUBLIC_MIKE_WIDGET_SITE_TOKEN=

# ── Clerk — same app as AIX Core. No local login page. ───────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Required on Railway when proxy.ts uses dynamic Clerk options.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CLERK_ENCRYPTION_KEY=

CLERK_SIGN_IN_URL=https://app-staging.aiworkforce.md/login
CLERK_SIGN_UP_URL=https://app-staging.aiworkforce.md/signup
CLERK_ALLOWED_REDIRECT_ORIGINS=http://localhost:3001
CLERK_AUTHORIZED_PARTIES=https://app-staging.aiworkforce.md,http://localhost:3001

NEXT_PUBLIC_CORE_API_URL=https://api-staging.aiworkforce.md
NEXT_PUBLIC_CORE_APP_URL=https://app-staging.aiworkforce.md

# Optional: force auth debug logs outside staging/dev
# NEXT_PUBLIC_AUTH_DEBUG=true

# Local Clerk bypass — server-only. Never set on Railway.
# APP_ENV=local
# MIKE_ALLOW_LOCAL_UNAUTH=true
