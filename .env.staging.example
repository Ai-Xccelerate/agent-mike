# Railway → mike-api → Variables. Never commit filled values.
APP_ENV=staging
DATABASE_URL=${{Postgres.DATABASE_URL}}
DEMO_MODE=false

OPENAI_API_KEY=

# Shared Clerk application and AIX Core catalog contract.
# Required as of the AI Worker Foundation v2 migration: lib/identity.ts's
# defaultAdapter() now switches on this var alone (no more auto-detecting a
# deployed Railway/staging/production environment the way v1's
# platformAuthRequired() did) — leaving it unset here would make every
# manager request resolve to the single "default" org instead of each
# request's real verified Clerk org, even though middleware.ts would still
# correctly reject unauthenticated requests.
MIKE_PLATFORM_AUTH=true
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=https://app-staging.aiworkforce.md,https://mike-staging.aiworkforce.md
AIX_CORE_API_URL=https://api-staging.aiworkforce.md
AIX_CORE_AGENT_SLUG=mike
CORS_ALLOWED_ORIGINS=https://app-staging.aiworkforce.md,https://mike-staging.aiworkforce.md

# Composio stays server-side on mike-api.
COMPOSIO_API_KEY=
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
COMPOSIO_GOOGLECALENDAR_AUTH_CONFIG_ID=
COMPOSIO_OUTLOOK_AUTH_CONFIG_ID=
COMPOSIO_LINEAR_AUTH_CONFIG_ID=
COMPOSIO_JIRA_AUTH_CONFIG_ID=
COMPOSIO_ZOHO_AUTH_CONFIG_ID=

# Nylas worker identity (Foundation Settings > Identity flow).
NYLAS_CLIENT_ID=
NYLAS_API_KEY=
NYLAS_API_URI=https://api.us.nylas.com
NYLAS_CALLBACK_URI=https://mike-api-staging.aiworkforce.md/api/v1/mailbox/callback
# Reserved for Foundation webhook support when wired upstream.
NYLAS_WEBHOOK_SECRET=
NYLAS_STATE_SECRET=

# Encrypts per-org provider credentials stored in Postgres.
ENCRYPTION_KEY=

# Optional Foundation integrations. Leave each pair unset to disable it.
PARCHMENT_API_URL=https://parchment-api-staging.aiworkforce.md
PARCHMENT_INTERNAL_AGENT_KEY=
AGENTDB_API_URL=https://agentdb-aix-staging.up.railway.app
AGENTDB_INTERNAL_AGENT_KEY=
SCRIBE_MCP_URL=https://api-scribe.aiworkforce.md/api/mcp
SCRIBE_MCP_TOKEN=
ARTIFACTS_MCP_URL=https://artifacts-api-staging.aiworkforce.md/mcp
ARTIFACTS_MCP_TOKEN=
AGENT_WIKI_MCP_URL=https://api-staging-a603.up.railway.app/mcp/
AGENT_WIKI_API_KEY=
AIX_SKILLS_MCP_URL=https://api-staging-da41.up.railway.app/mcp
AIX_SKILLS_API_KEY=

# Optional Railway Storage Bucket for persistent avatars.
# BUCKET=
# ACCESS_KEY_ID=
# SECRET_ACCESS_KEY=
# ENDPOINT=
# REGION=auto

# Intentionally absent on Railway:
# MIKE_ALLOW_LOCAL_UNAUTH
# MULTI_AGENT
