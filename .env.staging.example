# Staging API variables for Railway → mike-api → Variables → Raw Editor.
# Paste this block, then fill every empty value.
# Do NOT commit a filled copy. Secret values come from the Core kit /
# Jules-Nick staging Railway / Nylas dashboard — never invent them.
#
# Skip: MIKE_ALLOW_LOCAL_UNAUTH (must not be set on Railway).

APP_ENV=staging
DATABASE_URL=${{Postgres.DATABASE_URL}}
DEMO_MODE=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TRANSCRIBE_LANGUAGE=en

# Copy from Jules or Nick API staging, or aix-clerk-core-env-values.md
CLERK_JWKS_URL=
CLERK_ISSUER=

# After mike-frontend has a public URL, add it here next to Core.
# Example: https://app-staging.aiworkforce.md,https://mike-frontend-xxxx.up.railway.app
CLERK_AUTHORIZED_PARTIES=https://app-staging.aiworkforce.md

AIX_CORE_API_URL=https://api-staging.aiworkforce.md
AIX_CORE_API_BASE_URL=https://api-staging.aiworkforce.md

# After mike-frontend has a public URL, put that origin here.
CORS_ALLOWED_ORIGINS=https://app-staging.aiworkforce.md
CORS_ORIGINS=https://app-staging.aiworkforce.md
NEXT_PUBLIC_WIDGET_ORIGIN=

# Generate: openssl rand -hex 32
MIKE_WIDGET_SITE_TOKEN=
# Clerk org id that widget/email traffic should belong to
MIKE_WIDGET_ORG_ID=

# Nylas Agent Account (agent.mike@wkr.email or staging mailbox)
# App-wide credentials + grant UUID (Settings only asks for mailbox email).
NYLAS_API_KEY=
NYLAS_API_URI=https://api.us.nylas.com
NYLAS_WEBHOOK_SECRET=
NYLAS_GRANT_ID=
NYLAS_MAILBOX_EMAIL=agent.mike@wkr.email
