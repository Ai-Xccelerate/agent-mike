# AI Worker Foundation — API environment template. Copy to .env.local.
# Never commit secrets.

# ── Runtime ──────────────────────────────────────────────────────────────────
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_worker

# ── OpenAI Agents SDK ────────────────────────────────────────────────────────
OPENAI_API_KEY=
# When true, skip live OpenAI calls and return a canned demo response.
DEMO_MODE=true

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3001
