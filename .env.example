# AI Worker Foundation — API environment template. Copy to .env.local.
# Never commit secrets.

# ── Runtime ──────────────────────────────────────────────────────────────────
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_worker

# ── OpenAI Agents SDK ────────────────────────────────────────────────────────
OPENAI_API_KEY=
# When true, skip live OpenAI calls and return a canned demo response.
DEMO_MODE=true

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3001

# Composio API key — connected-account OAuth tokens live in Composio, not this app.
# Get one from the Composio dashboard: https://platform.composio.dev
COMPOSIO_API_KEY=

# Composio auth config ids, one per vendor/toolkit. Add another SYSTEM -> env var
# mapping in lib/tools-integrations/auth-configs.ts when onboarding a new vendor.
COMPOSIO_ZOHO_AUTH_CONFIG_ID=
COMPOSIO_LINEAR_AUTH_CONFIG_ID=
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
COMPOSIO_OUTLOOK_AUTH_CONFIG_ID=
COMPOSIO_GOOGLECALENDAR_AUTH_CONFIG_ID=

# ── Parchment (knowledge base integration) ───────────────────────────────────
# Internal AIX Core agent path: three headers, no per-workspace API key.
# See Parchment docs/agent-integration-internal.md.
# Unset either value and the integration reports as unavailable and never calls out.
PARCHMENT_API_URL=https://parchment-api-staging.aiworkforce.md
PARCHMENT_INTERNAL_AGENT_KEY=
# Attribution label sent as X-Agent-Id (falls back to the worker's slug).
PARCHMENT_AGENT_ID=
# The org id Parchment knows this organization by (X-Clerk-Org-Id).
# This build has no Clerk, so it must be supplied; falls back to the local org id.
PARCHMENT_ORG_ID=

# -- AgentDB (database integration) -------------------------------------------
# Internal AIX Core agent path: three headers, no per-workspace API key, plus MCP.
# See agentdb-aix docs/agent-integration-internal.md.
# Unset either value and the integration reports as unavailable and never calls out.
AGENTDB_API_URL=https://agentdb-aix-staging.up.railway.app
AGENTDB_INTERNAL_AGENT_KEY=
# Attribution label sent as X-Agent-Id (falls back to the worker slug).
AGENTDB_AGENT_ID=
# The org id AgentDB knows this organization by (X-Clerk-Org-Id).
# This build has no Clerk, so it must be supplied; falls back to the local org id.
AGENTDB_ORG_ID=
# One-time user Clerk JWT, used ONLY by the enable call (/workspaces/resolve).
# AgentDB refuses to enable an org without one. MCP never needs it, so this can
# be left unset once the org has been enabled from any AIX Core product.
AGENTDB_ENABLE_JWT=

# -- Scribe (meeting notetaker integration) -----------------------------------
# Single org-scoped bearer token against one MCP endpoint (no internal-key headers).
# Read-only: meetings, transcripts, insights, action items, meeting intelligence.
# Unset either value and the integration reports as unavailable and never calls out.
SCRIBE_MCP_URL=https://api-scribe.aiworkforce.md/api/mcp
SCRIBE_MCP_TOKEN=

# -- Agent Artifacts (AI Xccelerate Artifact Engine, over MCP) -----------------
# Workspace bearer token from the Artifact Engine: Settings > Agent access.
# MCP revision 2026-07-28 (no initialize; _meta envelope + mcp-method headers).
# WRITE-capable: creates and can publish artifacts that count against the
# workspace quota. Unset either value and the integration reports unavailable.
ARTIFACTS_MCP_URL=https://artifacts-api-staging.aiworkforce.md/mcp
ARTIFACTS_MCP_TOKEN=
# Display only — the workspace these tokens act as. Never sent.
ARTIFACTS_ORG_ID=

# -- Agent Wiki (organization wiki spaces, over MCP) ---------------------------
# Single bearer API key against one MCP endpoint, like Scribe (no internal-key
# headers). Create the key in Agent Wiki under Settings > API keys.
#
# The key carries the permissions of whoever created it: a key made without
# "let this key change pages" is refused by the server when it tries to write,
# whatever the worker's allowWrite setting says. Grant write only if you want
# the worker editing the wiki.
#
# Unset either value and the integration reports as unavailable and never calls out.
AGENT_WIKI_MCP_URL=https://api-staging-a603.up.railway.app/mcp/
AGENT_WIKI_API_KEY=
# Display only — what the key was created for (e.g. "AI Worker"). Never sent.
AGENT_WIKI_KEY_LABEL=
