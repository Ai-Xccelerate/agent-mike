# Agent Mike API — environment template
# Copy to .env.local. NEVER commit secrets. Values come from the AIX Core kit
# (aix-clerk-core-env-values.md) and Railway, not from this file.

# ── Runtime ──────────────────────────────────────────────────────────────────
APP_ENV=local
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mike

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
# When true, skip live Claude and AgentMail sends. Not an auth bypass.
DEMO_MODE=true

# ── Clerk JWT verification (same Clerk app as AIX Core) ──────────────────────
CLERK_JWKS_URL=
CLERK_ISSUER=
# Must include Core origin AND Mike frontend origin (azp check).
# Local: https://app-staging.aiworkforce.md,http://localhost:3001
# Staging: https://app-staging.aiworkforce.md,https://mike-staging.aiworkforce.md
CLERK_AUTHORIZED_PARTIES=https://app-staging.aiworkforce.md,http://localhost:3001

# ── AIX Core access gate ─────────────────────────────────────────────────────
# GET ${AIX_CORE_API_URL}/api/v1/agents/mike/access with the user JWT.
AIX_CORE_API_URL=https://api-staging.aiworkforce.md
AIX_CORE_API_BASE_URL=https://api-staging.aiworkforce.md

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3001,https://mike-staging.aiworkforce.md
CORS_ORIGINS=http://localhost:3001
NEXT_PUBLIC_WIDGET_ORIGIN=http://localhost:3001

# ── Local Clerk bypass (fail closed outside local next dev) ──────────────────
# Requires ALL of: this flag, APP_ENV=local, NODE_ENV!=production, no RAILWAY_ENVIRONMENT.
# Never set this on Railway staging or production — boot will throw.
MIKE_ALLOW_LOCAL_UNAUTH=true
MIKE_DEV_ORG_ID=dev-org
MIKE_DEV_USER_ID=dev-user

# ── Widget (public chat). Site token is not a user credential. ───────────────
# Required in staging/production for /widget chat. Fail closed if missing.
MIKE_WIDGET_SITE_TOKEN=
MIKE_WIDGET_ORG_ID=

# ── AgentMail ────────────────────────────────────────────────────────────────
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
AGENTMAIL_WEBHOOK_SECRET=
# Org that inbound email is stored against. Required in deployed environments.
AGENTMAIL_ORG_ID=
